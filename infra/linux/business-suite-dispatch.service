[Unit]
Description=Dispatch Business Suite commerce outbox
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/business-suite-main.env
ExecStart=/usr/bin/python3 /srv/business-suite/infra/linux/dispatch.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
