(public_headers) {
    encode gzip
    request_body {
        max_size 6MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @dispatch path /api/platform/dispatch
    respond @dispatch 404
}
portfolio.tsplsimulator.dpdns.org {
    import public_headers
    reverse_proxy web:8080
}
platform.tsplsimulator.dpdns.org {
    import public_headers
    redir / /platform 302
    reverse_proxy web:8080
}
